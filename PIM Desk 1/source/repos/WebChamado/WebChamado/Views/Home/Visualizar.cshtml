@{
    ViewData["Title"] = "Visualizar Chamados";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <style>
 
        body {
            background-color: #6E6E6E;
        }

        
        .container-chamados {
            margin: 150px auto;
            width: 90%; 
            max-width: 500px; 
            padding: 40px;
            background-color: #494949; 
            border-radius: 12px; 
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); 
            text-align: center; 
            
           
        }

            
            .container-chamados h1 {
                color: #4a90e2; 
                margin-bottom: 20px;
                font-size: 1.8em;
                font-weight: 700;
            }

            
            .container-chamados p {
                color: white;
                line-height: 1.6;
                margin-bottom: 30px;
            }

        
        .btn-download {
            display: inline-block;
            padding: 10px 25px;
            background-color: #4a90e2; 
            color: lightgray;
            text-decoration: none; 
            border-radius: 6px;
            font-weight: bold;
            transition: background-color 0.3s ease; 
        }

            .btn-download:hover {
                color: lightgray;
                background-color: #357ABD; 
            }
    </style>
</head>

<body>
    <div class="container-chamados">
        <h1>Visualizar Chamados</h1>
        <p>
            Para visualizar seus chamados, acesse a versão
            mobile do sistema. Baixe o aplicativo para
            acompanhar o andamento dos seus atendimentos.
        </p>
        <a href="#" class="btn-download">Baixar Aplicativo</a>
    </div>
</body>
</html>
