@{
    ViewData["Title"] = "_Layout";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebChamado</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        :root {
            --bg: #121212;
            --card: #1e1e1e;
            --accent: #3a7bd5;
            --text: #f0f0f0;
            --text-muted: #a0a0a0;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        header {
            background-color: var(--card);
            box-shadow: 0 2px 8px rgba(0,0,0,0.4);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            header h1 {
                font-size: 1.4rem;
                color: var(--accent);
                margin: 0;
            }

        nav a {
            color: var(--text);
            text-decoration: none;
            margin-left: 1rem;
            font-weight: 500;
            transition: color 0.2s ease;
        }

            nav a:hover {
                color: var(--accent);
            }

        main {
            flex: 1;
            padding: 2rem;
        }

        footer {
            background-color: var(--card);
            color: var(--text-muted);
            text-align: center;
            padding: 1rem 0;
            font-size: 0.9rem;
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        .btn-primary {
            background-color: var(--accent);
            border: none;
            transition: 0.2s ease;
        }

            .btn-primary:hover {
                background-color: #2e68b5;
                transform: scale(1.02);
            }
    </style>
</head>

<body>
    <header>
        <h1>PIM Desk</h1>
        <nav>
            <a asp-controller="Home" asp-action="Index">Início</a>
            <a asp-controller="Home" asp-action="Visualizar">Visualizar</a>
        </nav>
    </header>

    <main role="main" class="container">
        @RenderBody()
    </main>

    <footer>
        &copy; @DateTime.Now.Year - WebChamado | Todos os direitos reservados
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
