<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
        body {
            background-color: #6e6e6e;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            margin: 0;
        }

        .container-home {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 80vh;
        }

        .btn-novo {
            background-color: #232323;
            color: white;
            padding: 14px 32px;
            border-radius: 50px;
            font-weight: bold;
            text-decoration: none;
            font-size: 16px;
            transition: 0.3s ease;
        }

            .btn-novo:hover {
                background-color: #232323;
                transform: scale(1.05);
                color: #3a7bd5;
            }
    </style>
</head>
<body>
    <div class="container-home">
        <a asp-controller="Chamado" asp-action="AbrirChamado" class="btn-novo">Novo Ticket +</a>
    </div>
</body>
</html>
